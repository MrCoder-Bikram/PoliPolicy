# Set these in Vercel Project Settings > Environment Variables.
# Generate SESSION_SECRET as a random value of at least 32 characters.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Use a persistent managed MySQL database on Vercel; create the database with your
# provider first. The app creates its tables on startup. SQLite is local-development only.
MYSQL_HOST="your-mysql-host"
MYSQL_PORT="3306"
MYSQL_USER="your-mysql-user"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_DATABASE="insurecare"

# The first administrator is created from these values on initial database setup.
OWNER_EMAIL="admin@example.com"
OWNER_PASSWORD="replace-with-a-strong-unique-password"
OWNER_NAME="Administrator"
OWNER_PHONE="+1 415 800 9001"

# Production creates this admin and an illustrative policy catalogue, but does not
# create demo users, claims, payments, audit records, or placeholder hospitals.

